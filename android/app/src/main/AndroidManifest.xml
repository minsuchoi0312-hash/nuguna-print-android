<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 권한: 위험 권한(위치 · 카메라 · 저장소 · 연락처) 없음 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 같은 와이파이의 프린터 찾기: 와이파이 주소·대역 읽기, mDNS(멀티캐스트) 응답 받기 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- USB OTG 프린터(있으면 쓰고, 없는 폰도 설치 가능). 장치마다 화면에서 사용자 허락을 받는다 -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 다른 앱의 '공유'에서 누구나프린트 고르기: 사진 · PDF · 글 파일, 한 장 또는 여러 장 -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- 다른 앱(카카오톡 · 메신저 · 파일 앱)의 '연결 앱 · 다른 앱으로 열기'에서 누구나프린트 고르기.
                 content:// 만 받는다(file:// 은 SharedInbox 에서도 거절) -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 프린터 연결 링크(공개 연결 페이지 connect.html 이 여는 nugunaprint://connect?ip=…&name=…).
                 받은 값은 화면(connect-link.ts)이 다시 거른다 — 연결만 하고 인쇄는 하지 않는다 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nugunaprint" android:host="connect" />
            </intent-filter>

        </activity>

        <!-- 시스템 인쇄 서비스: 설정 → 인쇄(삼성: 모든 프린터 → 프린터 추가)에 누구나프린트로 보인다.
             다른 앱의 인쇄로 받은 문서를 폰에서 흑백 PCL 래스터로 바꿔 같은 와이파이 복사기 9100 으로 보낸다 -->
        <service
            android:name=".printservice.NugunaPrintService"
            android:label="@string/print_service_label"
            android:permission="android.permission.BIND_PRINT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.printservice.PrintService" />
            </intent-filter>
            <meta-data
                android:name="android.printservice"
                android:resource="@xml/printservice" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
